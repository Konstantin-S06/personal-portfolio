{
  "name": "personal-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run gen-stops",
    "dev": "vite",
    "gen-stops": "tsx scripts/gen-stops.ts",
    "sync-data": "node -e \"require('fs').copyFileSync('backend/projects.json', 'src/data/projects.json')\"",
    "build": "npm run sync-data && npm run gen-stops && tsc --noEmit && vite build",
    "preview": "vite preview",
    "pick-nature": "node scripts/pick-nature.mjs"
  },
  "dependencies": {
    "postprocessing": "^6.39.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "obj2gltf": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
